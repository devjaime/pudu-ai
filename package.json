{
  "name": "localmeter-ai",
  "version": "0.1.0",
  "description": "Local AI hardware & benchmark lab for the terminal",
  "keywords": [
    "ai",
    "llm",
    "benchmark",
    "ollama",
    "llama.cpp",
    "tui",
    "local"
  ],
  "homepage": "https://github.com/devjaime/pudu-ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devjaime/pudu-ai.git"
  },
  "bugs": {
    "url": "https://github.com/devjaime/pudu-ai/issues"
  },
  "license": "MIT",
  "author": "devjaime",
  "type": "module",
  "bin": {
    "localmeter-ai": "./dist/cli/index.js"
  },
  "exports": {
    ".": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "execa": "^9.6.0",
    "ink": "^5.2.1",
    "react": "^19.2.8",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.18",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
