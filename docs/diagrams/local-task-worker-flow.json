  "cards": [
    {
      "dot": "cyan",
      "title": "Entrada y contexto",
      "items": [
        "Tipos: analysis · summary · code_review · test_generation · documentation",
        "Contexto predeterminado: 8 archivos máx.; 12 KB/archivo y 48 KB total",
        "Solo lectura: omite secretos, symlinks y directorios excluidos"
      ]
    },
    {
      "dot": "violet",
      "title": "Ruteo y límites",
      "items": [
        "Esfuerzo determinista por tipo; repositorio grande puede subir un nivel",
        "Modelo explícito instalado; auto usa historial verificado o nombre estable",
        "Ollama solo por loopback. Sin cloud, shell, comandos generados ni cambios de código"
      ]
    },
    {
      "dot": "rose",
      "title": "Evidencia, no garantía",
      "items": [
        "Comprobación estructural: texto / JSON y campos solicitados; no factualidad",
        "Telemetría atómica repo-local: métricas y códigos permitidos, sin prompt ni respuesta",
        "Retorno JSON éxito / fallo; fuera de telemetría, la tarea no escribe archivos"
      ]
    }
